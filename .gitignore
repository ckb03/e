# Data
*.csv
*.pt
*.pkl
*.png
*.html
*.pdf
*.arrow
*.feather
*.bak
*.parquet

# Retain everything in docs
!docs/
!docs/**

# Local environments, generated datasets, and run artifacts
.venv/
eval_data/*.jsonl
eval_runs/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Commit the exact frozen comparison set
!eval_data/frozen_manifest-v2.jsonl

# Machine-local research environments and caches
.judge-venv/
cleanroom/
data_cache/

# Editor/patch backups and local runner helpers
*.orig
*.rej
tmux_codex.sh

# Bulky raw replay transcripts and transient run state
research_outputs/**/*.jsonl
research_outputs/**/*.log
research_outputs/**/status.json
research_outputs/**/run_state.json
research_outputs/**/__pycache__/
research_outputs/**/*.lock
research_outputs/handoff/*.patch
research_outputs/handoff/*.patch.sha256
